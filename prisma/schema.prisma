// QR Menü Sistemi — Prisma şeması
// Bkz. BACKEND_PLAN.md (multi-tenant, businessId ile satır izolasyonu)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  STAFF
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum LayoutPreset {
  CLASSIC
  GRID
  MAGAZINE
  COMPACT
  STORY
}

enum MenuSchedule {
  ALL_DAY
  MORNING
  LUNCH
  DINNER
  SEASONAL
  SPECIAL
}

enum MediaType {
  IMAGE
  VIDEO
  MODEL_3D
}

enum SpiceTolerance {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum ScanType {
  SCAN
  VIEW
  AR_OPEN
  PAIR_CLICK
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BusinessType {
  SINGLE // tekil işletme — tek menü
  CHAIN // zincir işletme — şube başına ayrı menü
}

enum Plan {
  STANDART // sadece görsel
  PRO // görsel + video
  MAX // görsel + video + AR/3D
}

// ----------------------------------------------------------------------------
// Tenant & kullanıcılar
// ----------------------------------------------------------------------------

model Business {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  status       BusinessStatus @default(PENDING)
  type         BusinessType   @default(SINGLE)
  // İşletme iletişim / profil bilgileri (hepsi opsiyonel)
  logoUrl      String? // işletme logosu (R2)
  phone        String?
  contactEmail String?
  address      String?
  about        String? // hakkında metni
  openingHours String? // açık saatler (serbest metin)
  mapUrl       String? // Google Maps linki (yol tarifi)
  socialLinks  Json     @default("{}") // { instagram, tiktok, facebook, x, youtube, website }
  // SEO (admin panelinden ayarlanır)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  // Bakım modu — açıkken müşteri menüsü yerine bilgilendirme ekranı
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  currency     String   @default("TRY") // görüntüleme para birimi (ISO 4217, bkz. lib/currency.ts)
  themeKey     String   @default("mineral") // müşteri menüsü teması (bkz. lib/themes.ts)
  allowedThemes String[] @default([]) // admin'in açtığı premium temalar (free temalar her zaman açık)
  // Üyelik planı + admin'in eklediği ekstra medya kotası (plan limitinin üzerine eklenir)
  plan         Plan     @default(STANDART)
  videoQuota   Int      @default(0) // plan dışı ekstra video hakkı (admin verir)
  arQuota      Int      @default(0) // plan dışı ekstra AR/3D hakkı (admin verir)
  ratingsEnabled Boolean @default(true) // müşteri yıldız puanı açık mı
  coverUrl     String? // müşteri menüsü hero kapak görseli (R2)
  heroOverline String? // hero üst etiket (örn. "BUGÜN")
  heroTitle    String? // hero serif başlık
  heroSubtitle String? // hero alt metin
  // QR açılış (splash) ekranı — Pro/Max. Açıksa menü öncesi karşılama gösterilir
  splashEnabled  Boolean @default(false)
  splashImageUrl String? // açılış görseli (R2)
  splashVideoUrl String? // açılış videosu (R2, opsiyonel)
  // WiFi bilgisi — müşteri menüsünde gösterilebilir (işletme aç/kapa yapar)
  wifiSsid     String?
  wifiPassword String?
  wifiShow     Boolean @default(false)
  // Yapılandırılmış çalışma saatleri — { mon: {open,close,closed}, ... } (bkz. lib/opening-hours.ts)
  // Açık/Kapalı rozetini gerçek saate göre hesaplamak için. openingHours (serbest metin) korunur.
  openingHoursJson Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  users        User[]
  themeConfig  ThemeConfig?
  subscription Subscription?
  menus        Menu[]
  products     Product[]
  scanEvents   ScanEvent[]
  deletionRequests AccountDeletionRequest[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  role            Role     @default(BUSINESS_OWNER)
  twoFactorSecret String? // uygulama katmanında şifrelenir
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  resetTokens PasswordResetToken[]

  @@index([businessId])
}

// Şifre sıfırlama token'ı — ham token mail'e gider, DB'de sha256 hash saklanır.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Hesap silme isteği — işletme talep eder, admin onaylayınca işletme silinir.
// status: PENDING | REJECTED (APPROVED durumunda işletme + bu kayıt cascade silinir)
model AccountDeletionRequest {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedById String?
  reason        String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedById  String?

  @@index([businessId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Tema / şablon (DB'de JSON config)
// ----------------------------------------------------------------------------

model ThemeConfig {
  id           String       @id @default(cuid())
  businessId   String       @unique
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  layoutPreset LayoutPreset @default(CLASSIC)
  colors       Json // { primary, secondary, background, surface, text }
  typography   Json // { headingFont, bodyFont }
  branding     Json // { logoUrl, coverUrl? }
  options      Json // { showRatings, showCalories, darkModeDefault }
  updatedAt    DateTime     @updatedAt
}

// ----------------------------------------------------------------------------
// Menü, kategori, ürün
// ----------------------------------------------------------------------------

model Menu {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String? // zincir şube URL'i için (/m/[isletme]/[sube]); tekil işletmede null
  // Şubeye özel ayarlar (zincir işletmelerde; boş/null ise marka geneli kullanılır)
  phone        String?
  address      String?
  openingHours String?
  contactEmail String?
  logoUrl      String?
  mapUrl       String?
  socialLinks  Json     @default("{}")
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  themeKey   String? // null → marka teması
  currency   String? // null → marka para birimi
  schedule   MenuSchedule @default(ALL_DAY)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  categories Category[]
  versions   MenuVersion[]
  scanEvents ScanEvent[]

  @@unique([businessId, slug])
  @@index([businessId])
}

model MenuVersion {
  id          String   @id @default(cuid())
  menuId      String
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  versionNo   Int
  snapshot    Json // menünün o anki tam görüntüsü (geri dönüş için)
  createdAt   DateTime @default(now())
  createdById String?

  @@unique([menuId, versionNo])
  @@index([menuId])
}

model Category {
  id        String @id @default(cuid())
  menuId    String
  menu      Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)
  translations Json @default("{}") // { en: { name }, de: { name } }
  description String? // kategori başlık kartı açıklaması
  imageUrl   String? // kategori kartı arka plan görseli (R2)
  videoUrl   String? // kategori kartı arka plan videosu (R2, opsiyonel)
  availStart String? // servis başlangıç "HH:MM" (boşsa hep açık)
  availEnd   String? // servis bitiş "HH:MM"
  // Kategori kampanyası (tüm ürünlere zamanlı indirim + rozet)
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignStart     String? // saat "HH:MM"
  campaignEnd       String?
  campaignDateStart String? // tarih "YYYY-MM-DD"
  campaignDateEnd   String?
  campaignDiscType  String? // "percent" | "fixed"
  campaignDiscValue Decimal? @db.Decimal(10, 2)

  products Product[]

  @@index([menuId])
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  calories    Int?
  prepMinutes Int? // hazırlık süresi (dk)
  weight      String? // gramaj/hacim, serbest metin (örn. "250 g", "1 L")
  portion     String? // porsiyon bilgisi, serbest metin (örn. "2 kişilik")
  isSoldOut   Boolean   @default(false)
  isFeatured  Boolean   @default(false) // Şefin Seçimi / öne çıkan
  isNew       Boolean   @default(false) // Yeni
  isPopular   Boolean   @default(false) // Popüler
  sortOrder   Int       @default(0)
  mediaType   MediaType @default(IMAGE)
  imageUrl    String?
  videoUrl    String? // R2: hazırlanış / tanıtım videosu
  modelGlbUrl String? // R2: 3D model (web / Android AR)
  modelUsdzUrl String? // R2: 3D model (iOS AR)
  translations Json    @default("{}") // { en: { name, description }, de: {...} }
  // Kampanya (opsiyonel)
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignStart String? // "HH:MM" — boşsa hep aktif
  campaignEnd   String? // "HH:MM"
  campaignDateStart String? // "YYYY-MM-DD"
  campaignDateEnd   String?
  campaignPrice Decimal? @db.Decimal(10, 2) // kampanya fiyatı; varsa eski fiyat üstü çizili gösterilir
  availStart   String? // servis başlangıç "HH:MM" (boşsa hep açık)
  availEnd     String? // servis bitiş "HH:MM"
  variations   Json     @default("[]") // [{ name, icon, price }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  allergens ProductAllergen[]
  ratings   Rating[]
  productRatings ProductRating[]
  pairings  ProductPairing[] @relation("PairFrom") // bu ürünün önerdiği eşleşmeler
  pairedBy  ProductPairing[] @relation("PairTo")

  @@index([categoryId, sortOrder])
  @@index([businessId])
  @@index([campaignId])
}

// "Yanında iyi gider" — ürünler arası yönlü eşleşme (tek yön).
model ProductPairing {
  productId String
  pairedId  String
  sortOrder Int     @default(0)
  product   Product @relation("PairFrom", fields: [productId], references: [id], onDelete: Cascade)
  paired    Product @relation("PairTo", fields: [pairedId], references: [id], onDelete: Cascade)

  @@id([productId, pairedId])
  @@index([productId])
}

// Anonim yıldız puanı (yorumsuz). Cihaz başına (anonId) ürün başına 1 oy,
// güncellenebilir. ipHash spam'e karşı yumuşak hız limiti için.
model ProductRating {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  anonId    String // cihaz çerezi (eq_anon)
  ipHash    String? // sha256(ip + salt) — ham IP saklanmaz (KVKK)
  stars     Int // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, anonId])
  @@index([productId])
  @@index([ipHash, createdAt])
}

// ----------------------------------------------------------------------------
// Alerjen (14 AB kategorisi)
// ----------------------------------------------------------------------------

model Allergen {
  id    String @id @default(cuid())
  code  String @unique
  label String

  products ProductAllergen[]
}

model ProductAllergen {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([productId, allergenId])
  @@index([allergenId])
}

// ----------------------------------------------------------------------------
// Müşteri profili & geri bildirim
// ----------------------------------------------------------------------------

model CustomerProfile {
  id               String         @id @default(cuid())
  anonId           String?        @unique // oturumsuz anonim kimlik
  userId           String?        @unique // hesaba bağlandıysa
  allergens        Json           @default("[]")
  favoriteCuisines Json           @default("[]")
  spiceTolerance   SpiceTolerance @default(NONE)
  languagePref     String         @default("tr")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  ratings Rating[]
}

model Rating {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stars      Int
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([productId])
}

// ----------------------------------------------------------------------------
// Analitik, abonelik, denetim
// ----------------------------------------------------------------------------

model ScanEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuId     String?
  menu       Menu?    @relation(fields: [menuId], references: [id], onDelete: SetNull)
  tableNo    String?
  productId  String?
  type       ScanType @default(SCAN)
  lang       String? // müşterinin menü dili (eq_lang) — turist/dil analitiği
  ts         DateTime @default(now())

  @@index([businessId, ts])
  @@index([menuId, type, ts])
}

model Subscription {
  id               String             @id @default(cuid())
  businessId       String             @unique
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tier             String // fiyat kademeleri TBD
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Platform dilleri — admin panelinden eklenir/açılır. TR temel dildir (kayıt yok).
model Language {
  code        String   @id // ISO: "en", "de", "ar"
  label       String // Türkçe ad: "İngilizce"
  nativeLabel String // yerel ad: "English"
  rtl         Boolean  @default(false) // Arapça vb. sağdan-sola
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// Genel anahtar/değer ayarları (örn. translation_model)
model AppSetting {
  key   String @id
  value String
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

// Admin'den yönetilen pazarlama sayfaları (blok tabanlı içerik, /[slug] altında yayınlanır)
model Page {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  seoTitle       String?
  seoDescription String?
  status         PageStatus @default(DRAFT)
  blocks         Json       @default("[]") // bkz. lib/page-blocks.ts
  navLabel       String? // navbar'da görünecek etiket (Faz 2)
  navOrder       Int        @default(0)
  showInNav      Boolean    @default(false)
  navItems       NavItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// Admin'den yönetilen site navbar'ı — gruplu (dropdown) menü öğeleri
model NavItem {
  id        String    @id @default(cuid())
  label     String
  description String? // dropdown'da etiketin altında görünen kısa açıklama
  icon      String? // lucide ikon adı (bkz. components/site/NavIcon.tsx)
  url       String? // harici/manuel link (pageId yoksa)
  pageId    String?
  page      Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    NavItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavItem[] @relation("NavChildren")
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
}

// Arayüz metni çevirileri (admin panelinden girilir). Anahtar + TR/EN
// varsayılanları koddadır (lib/ui-strings.ts); bu tablo onları geçersiz kılar.
model UiTranslation {
  lang  String
  key   String
  value String

  @@id([lang, key])
  @@index([lang])
}

// Kampanya etiketleri — admin panelinden eklenir/açılır. İşletme ürüne atar.
model Campaign {
  id           String   @id @default(cuid())
  label        String // Türkçe/temel etiket: "Happy Hour"
  color        String   @default("#ea580c") // rozet rengi (hex)
  translations Json     @default("{}") // { en: "Happy Hour", de: "..." }
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  products   Product[]
  categories Category[]
}

// Para birimleri — admin panelinden eklenir/açılır. İşletme birini seçer.
model Currency {
  code      String   @id // ISO 4217: "TRY", "USD"
  symbol    String // "₺"
  label     String // Türkçe ad
  position  String   @default("before") // "before" | "after" (sembol konumu)
  space     Boolean  @default(false) // sembol ile rakam arası boşluk
  decimals  Int      @default(2)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Plan başına medya limitleri — admin panelinden dinamik düzenlenir.
// Efektif limit = PlanLimit[business.plan] + business.videoQuota/arQuota
model PlanLimit {
  plan       Plan     @id
  videoLimit Int      @default(0) // bu planla kaç ürüne video eklenebilir
  arLimit    Int      @default(0) // bu planla kaç ürüne AR/3D eklenebilir
  features   Json     @default("{}") // plan bazlı özellik bayrakları, bkz. lib/plan-features.ts
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  meta       Json     @default("{}")
  ts         DateTime @default(now())

  @@index([actorId])
  @@index([ts])
}
